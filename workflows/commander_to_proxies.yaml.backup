name: "commander_to_proxies"
description: "Complete workflow: Search commander → Extract decklist → Generate proxies with parallel batch processing (10x speedup)"
version: "2.0"

inputs:
  commander_name:
    type: string
    required: true
    description: "Commander name (e.g., 'atraxa-praetors-voice')"

  max_cards:
    type: integer
    required: false
    default: 100
    description: "Maximum cards to extract"

# T021: Parallel batch processing configuration
batch_config:
  batch_size: 10
  max_concurrent: 3
  retry_strategy: "exponential_backoff"
  request_timeout_seconds: 30
  retry_policy:
    max_retries: 3
    initial_delay_seconds: 1.0
    max_delay_seconds: 8.0
    jitter_enabled: true
    retryable_errors:
      - "HTTP_429"
      - "NETWORK_TIMEOUT"

steps:
  # Step 1: Fetch commander page from EDHREC
  - name: fetch_page
    skill: data/fetch-web-page
    args:
      url: "https://edhrec.com/commanders/{{inputs.commander_name}}"
      output_dir: ".claude/downloads"
    outputs:
      html_path: ".claude/downloads/commanders_{{inputs.commander_name}}.html"

  # Step 2: Extract card names from HTML
  - name: extract_cards
    skill: data/extract-cards-from-html
    args:
      html_file: "{{steps.fetch_page.outputs.html_path}}"
      output_file: "decklists/{{inputs.commander_name}}_extracted.txt"
      max_cards: "{{inputs.max_cards}}"
    outputs:
      decklist_path: "decklists/{{inputs.commander_name}}_extracted.txt"
      card_names: "{{result.card_names}}"

  # Step 3: Fetch card metadata (atomic skill - replaces monolithic fetch-cards)
  - name: fetch_card_data
    skill: data/fetch-card-data
    batch_mode: true
    args:
      card_names: "{{steps.extract_cards.outputs.card_names}}"
      options:
        fuzzy_match: true
        include_prices: false
        timeout: 10
    outputs:
      cards_data: "{{result.cards}}"

  # Step 4: Download card images in parallel batches (atomic skill - 10x speedup)
  - name: fetch_card_images
    skill: images/fetch-card-image
    batch_mode: true
    args:
      cards_data: "{{steps.fetch_card_data.outputs.cards_data}}"
      output_dir: "images"
      options:
        image_quality: "normal"
        timeout: 30
        validate_image: true
    outputs:
      images: "{{result.images}}"
      image_paths: "{{result.images}}"

  # Step 5: Generate PPTX slides (atomic skill - 9 cards per slide)
  - name: generate_slides
    skill: presentation/generate-slide
    args:
      image_paths: "{{steps.fetch_card_images.outputs.image_paths}}"
      output_file: "outputs/{{inputs.commander_name}}_proxies.pptx"
      options:
        cards_per_slide: 9
        template: "template_2v6h_FIXED.pptx"
        slide_width_inches: 10
        slide_height_inches: 7.5
    outputs:
      pptx_path: "{{result.pptx_path}}"
      total_slides: "{{result.total_slides}}"

  # Step 6: Convert PPTX to PDF (optional - preserves existing functionality)
  - name: convert_to_pdf
    skill: pdf/convert-to-pdf
    args:
      pptx_file: "{{steps.generate_slides.outputs.pptx_path}}"
      output_file: "outputs/{{inputs.commander_name}}_proxies.pdf"
    outputs:
      pdf_path: "{{result.pdf_path}}"

outputs:
  commander: "{{inputs.commander_name}}"
  decklist: "{{steps.extract_cards.outputs.decklist_path}}"
  pptx: "{{steps.generate_slides.outputs.pptx_path}}"
  pdf: "{{steps.convert_to_pdf.outputs.pdf_path}}"
  manifest: ".execution_manifests/commander_to_proxies_{{workflow_run_id}}.jsonl"
  total_cards: "{{steps.fetch_card_data.outputs.successful}}"
  total_slides: "{{steps.generate_slides.outputs.total_slides}}"
