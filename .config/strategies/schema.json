{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["domain", "detection_patterns", "category_patterns", "inference_rules"],
  "properties": {
    "domain": {
      "type": "string",
      "description": "Domain identifier (e.g., 'mtg', 'pokemon', 'dnd')",
      "pattern": "^[a-z_][a-z0-9_]*$"
    },
    "version": {
      "type": "string",
      "description": "Config version (optional metadata)",
      "default": "1.0"
    },
    "detection_patterns": {
      "type": "object",
      "description": "Pattern categories mapping to detection keywords",
      "patternProperties": {
        "^[a-z_]+$": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        }
      }
    },
    "category_patterns": {
      "type": "object",
      "description": "Category names mapping to item patterns",
      "patternProperties": {
        "^.*$": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        }
      }
    },
    "inference_rules": {
      "type": "array",
      "description": "Conditional logic for category inference",
      "items": {
        "type": "object",
        "required": ["condition", "infer_categories", "rationale"],
        "properties": {
          "condition": {
            "type": "object",
            "description": "Match condition (e.g., {\"any_name_contains\": [\"Frog\"]})"
          },
          "infer_categories": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Categories to infer when condition matches"
          },
          "rationale": {
            "type": "string",
            "description": "Human-readable explanation"
          }
        }
      }
    }
  }
}
