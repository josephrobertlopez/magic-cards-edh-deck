{
  "domain": "mtg",
  "version": "1.0",
  "detection_patterns": {
    "basic_lands": ["Forest", "Island", "Mountain", "Plains", "Swamp"],
    "tribal_creatures": ["Frog", "Toad", "Goblin", "Elf", "Merfolk"]
  },
  "category_patterns": {
    "Forest": ["Forest"],
    "Island": ["Island"],
    "Mountain": ["Mountain"],
    "Plains": ["Plains"],
    "Swamp": ["Swamp"]
  },
  "inference_rules": [
    {
      "condition": {"any_name_contains": ["Frog", "Toad"]},
      "infer_categories": ["Forest", "Island"],
      "rationale": "Frog/Toad creatures are typically Simic (Green/Blue in MTG)"
    },
    {
      "condition": {"any_name_contains": ["Goblin"]},
      "infer_categories": ["Mountain"],
      "rationale": "Goblins are typically Red in MTG"
    }
  ]
}
